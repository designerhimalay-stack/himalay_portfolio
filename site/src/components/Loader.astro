---
const greeting = 'Hello';   /* loader.js cycles the rest; this is the SSR'd first frame */
---
<div class="loader" id="loader" role="status" aria-label="Loading">
  <div class="ld-mid">
    <svg class="ld-ast" viewBox="0 0 24 24" aria-hidden="true">
      <g stroke="currentColor" stroke-width="3.2" stroke-linecap="round">
        <path d="M12 2.5V21.5" /><path d="M3.77 7.25 20.23 16.75" /><path d="M3.77 16.75 20.23 7.25" />
      </g>
    </svg>
    <span class="ld-word swap" id="ldWord">{greeting}</span>
  </div>
  <div class="ld-pct"><span id="ldNum">0</span><span class="ld-sym">%</span></div>
</div>
