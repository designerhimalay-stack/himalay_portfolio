---
/* Section two — the statement, orbited by the tools.

   Two references, both derived rather than reproduced:

   amirmo.design §2 gives the ORBIT. Six saturated objects ring a narrow centred
   column at varying size and depth, none of them touching the text. It works
   because the objects are the only colour on the page and the text is the only
   thing with edges — depth without competition. Ours keeps that division of
   labour and changes everything else: the ring is asymmetric (three left, three
   right, none mirrored), the sizes run 60-96px rather than uniform, and the
   marks are built here as SVG rather than lifted as renders.

   yanxinzhang.com gives the PARAGRAPH: one long display sentence at generous
   leading with objects set into the line, so the eye pauses where the writing
   does. Theirs punctuates with photography and video; ours punctuates with the
   site's own glass marks, and each one does a word's work — & is the conjunction,
   % is a real quantity, * is the beat between two sentences. A mark that only
   decorated would read as a typo at this size.

   No video anywhere in the paragraph: a moving image inside a line of type wins
   every time and the sentence stops being read. */

/* left cluster then right, deliberately not mirrored — a symmetric ring reads as
   a frame and the column stops being the subject. --d is parallax depth (bigger
   = travels further), --ph offsets the float so the six never bob in unison. */
const tools = [
  { id: 'figma', x: '11%',  y: '19%', s: 78,  rz: -8,  ry: 14,  d: 0.9,  ph: '0s'    },
  { id: 'ae',    x: '4.5%', y: '56%', s: 92,  rz: 7,   ry: -12, d: 1.35, ph: '-2.2s' },
  { id: 'ps',    x: '16%',  y: '88%', s: 66,  rz: -12, ry: 10,  d: 0.6,  ph: '-4.6s' },
  { id: 'spline',x: '88%',  y: '15%', s: 84,  rz: 10,  ry: -14, d: 1.15, ph: '-1.1s' },
  { id: 'blend', x: '95%',  y: '52%', s: 72,  rz: -6,  ry: 12,  d: 0.75, ph: '-3.4s' },
  { id: 'rive',  x: '84%',  y: '85%', s: 88,  rz: 9,   ry: -10, d: 1.2,  ph: '-5.8s' },
];
---
<section class="ab" id="about">
  <!-- the orbit is decoration: it names tools the copy already claims, so nothing
       is lost when it is dropped from the a11y tree -->
  <div class="ab-orbit" aria-hidden="true">
    {tools.map((t) => (
      <figure class={'tool tool-' + t.id} style={`--x:${t.x};--y:${t.y};--s:${t.s}px;--rz:${t.rz}deg;--ry:${t.ry}deg;--d:${t.d};--ph:${t.ph}`}>
        <span class="tool-sh" />
        <span class="tool-b">
          {t.id === 'figma' && (
            <svg class="tool-ic" viewBox="0 0 38 57" role="img" aria-label="Figma">
              <path fill="#1ABCFE" d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z"/>
              <path fill="#0ACF83" d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z"/>
              <path fill="#FF7262" d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z"/>
              <path fill="#F24E1E" d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z"/>
              <path fill="#A259FF" d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z"/>
            </svg>
          )}
          {t.id === 'ae' && (
            <svg class="tool-ic" viewBox="0 0 100 100" role="img" aria-label="After Effects">
              <defs><linearGradient id="gAe" x1="0" y1="0" x2=".3" y2="1">
                <stop offset="0" stop-color="#4B39A8"/><stop offset="1" stop-color="#1C1250"/>
              </linearGradient></defs>
              <rect x="2" y="2" width="96" height="96" rx="26" fill="url(#gAe)"/>
              <rect x="7.5" y="7.5" width="85" height="85" rx="21.5" fill="none" stroke="#8E7BE8" stroke-opacity=".35" stroke-width="1.5"/>
              <text x="50" y="50" class="tool-tx" fill="#B3A4FF">Ae</text>
            </svg>
          )}
          {t.id === 'ps' && (
            <svg class="tool-ic" viewBox="0 0 100 100" role="img" aria-label="Photoshop">
              <defs><linearGradient id="gPs" x1="0" y1="0" x2=".3" y2="1">
                <stop offset="0" stop-color="#0B3358"/><stop offset="1" stop-color="#04182C"/>
              </linearGradient></defs>
              <rect x="2" y="2" width="96" height="96" rx="26" fill="url(#gPs)"/>
              <rect x="7.5" y="7.5" width="85" height="85" rx="21.5" fill="none" stroke="#31A8FF" stroke-opacity=".32" stroke-width="1.5"/>
              <text x="50" y="50" class="tool-tx" fill="#35A9FF">Ps</text>
            </svg>
          )}
          {t.id === 'rive' && (
            <svg class="tool-ic" viewBox="0 0 100 100" role="img" aria-label="Rive">
              <defs><linearGradient id="gRv" x1="0" y1="0" x2=".3" y2="1">
                <stop offset="0" stop-color="#41474F"/><stop offset="1" stop-color="#20242A"/>
              </linearGradient></defs>
              <rect x="2" y="2" width="96" height="96" rx="26" fill="url(#gRv)"/>
              <rect x="7.5" y="7.5" width="85" height="85" rx="21.5" fill="none" stroke="#FFFFFF" stroke-opacity=".14" stroke-width="1.5"/>
              <text x="50" y="50" class="tool-tx" fill="#EDEFF2">R</text>
            </svg>
          )}
          {t.id === 'spline' && (
            <svg class="tool-ic" viewBox="0 0 100 100" role="img" aria-label="Spline">
              <defs><linearGradient id="gSp" x1="0" y1="0" x2=".35" y2="1">
                <stop offset="0" stop-color="#3BE9BC"/><stop offset="1" stop-color="#0FBE93"/>
              </linearGradient></defs>
              <rect x="2" y="2" width="96" height="96" rx="26" fill="url(#gSp)"/>
              <path fill="#fff" d="M67.5 22.5 65 34.2c-6.6-1.5-11.6.6-12.5 4.6-.7 3.4 1.3 5.7 7.4 9.2 9.3 5.3 13.6 10.7 11.8 19.4-2.2 10.8-12.8 16.1-25.2 13.3l2.6-11.7c6.9 1.6 11.9-.7 12.8-4.9.8-3.8-1.5-6-8-9.7C45 48.9 40.4 43.5 42.1 35c2.1-10.5 12.6-15.7 25.4-12.5z"/>
            </svg>
          )}
          {t.id === 'blend' && (
            <svg class="tool-ic" viewBox="0 0 100 100" role="img" aria-label="Blender">
              <path d="M4 52.5c0-2.6 1.4-5 3.6-6.3l33-19c3.4-2 7.7.5 7.7 4.4V58H8a4 4 0 0 1-4-4z" fill="#E8710C"/>
              <circle cx="58" cy="58" r="34" fill="#F5792A"/>
              <ellipse cx="61" cy="50.5" rx="19.5" ry="17" fill="#fff"/>
              <ellipse cx="61" cy="50.5" rx="10" ry="8.8" fill="#2B5B87"/>
            </svg>
          )}
        </span>
      </figure>
    ))}
  </div>

  <div class="wrap">
    <div class="ab-col">
      <p class="ab-eye">Eight years in,</p>
      <!-- One source line on purpose: Astro drops the whitespace where a newline
           meets a tag, and "projects<em>end to end" shipped once already. -->
      <p class="ab-lead"><span class="mk mk-o" data-g="3" aria-hidden="true"><i>*</i></span>I design <em>products people keep using</em> — interfaces, design <span class="nb">systems <span class="mk" data-g="2"><i>&amp;</i></span></span> the motion that makes them feel alive. I run projects <em>end to end</em>, from the first audit to the last handoff spec, and I stay close to the build — because <em>the <span class="nb">last <span class="mk" data-g="1"><i>%</i></span></span> is the part people actually feel.</em></p>
      <p class="ab-body">Generalist by training — UI/UX and product design first, with branding, motion and 3D when the work calls for it. I’ve been the only designer in the room and one voice among many; both teach you to argue for the user with evidence, not taste.</p>
    </div>
  </div>
</section>
