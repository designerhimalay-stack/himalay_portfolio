---
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TextOnPath from '../components/TextOnPath.astro';
import Lab from '../components/Lab.astro';
import Dial from '../components/Dial.astro';
---
<Base
  title="himalay. — UI/UX designer"
  description="UI/UX designer building interfaces and experiences with staying power. Product design, design systems and prototyping for teams that sweat the details."
>
  <Loader />
  <Nav />
  <main id="top">
    <Hero />

    <!-- Section two: the dial. The hash is already parked at viewport centre by
         parallax.js when the hero ends, so the ring simply rises to meet it. -->
    <Dial />

    <!-- Section three: the glass alone. The sentence that used to ride it has
         moved down to section four, so this is now a quiet band of the same
         material — the staircase still climbs it, there is simply nothing
         written on it. -->
    <Lab />

    <!-- Section four: the same sheet, carrying the sentence.
         stepped.js pairs each .glass with its OWN .pane rather than picking the
         first of each globally, which is what lets two of these coexist. -->
    <div class="pane">
      <div class="glass" aria-hidden="true"></div>
      <TextOnPath />
    </div>

  </main>
</Base>
